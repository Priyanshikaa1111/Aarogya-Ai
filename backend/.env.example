# Google Gemini API key - get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model used for symptom checking, diet plans,
# and the chatbot. Defaults to gemini-3.1-flash-lite (a current, low-cost
# model) if not set. See https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.1-flash-lite

# Google Maps Platform API key with "Places API (New)" enabled - used by the
# "Find Care Near Me" feature. Get one at https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Cloud Translation API key - used by Indian Language Mode to translate
# AI health responses. Get one at https://console.cloud.google.com/apis/library/translate.googleapis.com
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# JWT secret - change this to a long random string in production
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_random_secret_key

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite database file path
DATABASE_URL=sqlite:///./medical_ai.db

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
